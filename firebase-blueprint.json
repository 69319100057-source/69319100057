{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Authenticated user profile and default monthly budget preference.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "Firebase Auth UID of the user.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "Verified Gmail / Google email address.",
          "minLength": 3,
          "maxLength": 254
        },
        "displayName": {
          "type": "string",
          "description": "User display name.",
          "minLength": 1,
          "maxLength": 120
        },
        "photoURL": {
          "type": "string",
          "description": "Profile avatar URL.",
          "maxLength": 500
        },
        "defaultMonthlyBudget": {
          "type": "number",
          "description": "Default monthly expense budget target in THB."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when the profile was created."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when the profile was last updated."
        }
      },
      "required": [
        "uid",
        "email",
        "displayName",
        "photoURL",
        "defaultMonthlyBudget",
        "createdAt",
        "updatedAt"
      ]
    },
    "Transaction": {
      "title": "Transaction",
      "description": "An income or expense record belonging to a user.",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "Owner Firebase Auth UID.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "type": {
          "type": "string",
          "description": "Transaction classification.",
          "enum": ["income", "expense"]
        },
        "amount": {
          "type": "number",
          "description": "Positive transaction amount in THB."
        },
        "category": {
          "type": "string",
          "description": "Category identifier.",
          "minLength": 1,
          "maxLength": 60,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "title": {
          "type": "string",
          "description": "Short transaction title or description.",
          "minLength": 1,
          "maxLength": 120
        },
        "note": {
          "type": "string",
          "description": "Optional detailed memo.",
          "maxLength": 500
        },
        "date": {
          "type": "string",
          "description": "Transaction date in YYYY-MM-DD format.",
          "minLength": 10,
          "maxLength": 10,
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "monthKey": {
          "type": "string",
          "description": "Year-month grouping key in YYYY-MM format.",
          "minLength": 7,
          "maxLength": 7,
          "pattern": "^\\d{4}-\\d{2}$"
        },
        "paymentMethod": {
          "type": "string",
          "description": "Payment channel used for the transaction.",
          "enum": [
            "cash",
            "bank_transfer",
            "promptpay",
            "credit_card",
            "e_wallet",
            "other"
          ]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when created."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when last updated."
        }
      },
      "required": [
        "userId",
        "type",
        "amount",
        "category",
        "title",
        "note",
        "date",
        "monthKey",
        "paymentMethod",
        "createdAt",
        "updatedAt"
      ]
    },
    "MonthlyBudget": {
      "title": "MonthlyBudget",
      "description": "Monthly expense budget limit for a specific YYYY-MM month.",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "Owner Firebase Auth UID.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "monthKey": {
          "type": "string",
          "description": "Target month in YYYY-MM format.",
          "minLength": 7,
          "maxLength": 7,
          "pattern": "^\\d{4}-\\d{2}$"
        },
        "limitAmount": {
          "type": "number",
          "description": "Expense budget limit for the month in THB."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when created."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when last updated."
        }
      },
      "required": [
        "userId",
        "monthKey",
        "limitAmount",
        "createdAt",
        "updatedAt"
      ]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": {
        "$ref": "#/entities/UserProfile"
      },
      "description": "Private user profile and preferences document."
    },
    "/users/{userId}/transactions/{transactionId}": {
      "schema": {
        "$ref": "#/entities/Transaction"
      },
      "description": "User-scoped income and expense ledger entries."
    },
    "/users/{userId}/budgets/{budgetId}": {
      "schema": {
        "$ref": "#/entities/MonthlyBudget"
      },
      "description": "User-scoped monthly expense budget targets keyed by YYYY-MM."
    }
  }
}
